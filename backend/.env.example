AI_MODE=sample
# Real integration requires team approval and a separate TEAM19_DATA_DIR:
# AI_MODE=real
# AI_PIPELINE_MODULE=pipeline
TEAM19_DATA_DIR=./backend/local-data
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_PDF_MB=20
# AI job threads: default sample=1, real=3; explicit overrides clamp to 1..4 / 1..3.
# BE_WORKERS=3
# Uvicorn must still use a single server process, without --reload.
SAMPLE_MP4=1
