        {
          "line": 1,
          "do": "setText",
          "target": "f_v",
          "args": [
            "$R_{ss'}^a+\\gamma V^\\pi(s')$"
          ]
        },
        {
          "line": 2,
          "do": "setText",
          "target": "f_v",
          "args": [
            "$\\sum_{s'}P_{ss'}^a\\left[R_{ss'}^a+\\gamma V^\\pi(s')\\right]$"
          ]
        },
        {
          "line": 3,
          "do": "setText",
          "target": "f_v",
          "args": [
            "$\\sum_a\\pi(s,a)\\sum_{s'}P_{ss'}^a\\left[R_{ss'}^a+\\gamma V^\\pi(s')\\right]$"
          ]
        },
        {
          "line": 4,
          "do": "setText",
          "target": "f_v",
          "args": [
            "$V^\\pi(s)=\\sum_a\\pi(s,a)\\sum_{s'}P_{ss'}^a\\left[R_{ss'}^a+\\gamma V^\\pi(s')\\right]$"
          ]
        }
