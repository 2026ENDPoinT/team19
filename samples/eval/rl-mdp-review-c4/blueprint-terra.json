          "content": "$V^\\pi(s)=\\sum_a\\pi(s,a)\\sum_{s'}P^a_{ss'}[R^a_{ss'}+\\gamma V^\\pi(s')]$",
          "hidden": false
        },
        {
          "id": "t2_note",
          "slot": "bottom",
