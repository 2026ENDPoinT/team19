          "id": "t_v",
          "slot": "top",
          "style": "title",
          "content": "상태가치의 벨만 방정식",
          "hidden": false
        },
        {
          "id": "f_v",
          "slot": "middle",
          "style": "formula",
          "content": "$R_{ss'}^a$",
          "hidden": false
