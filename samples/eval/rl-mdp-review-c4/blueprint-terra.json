          "content": "수익의 재귀 관계",
          "hidden": false
        },
        {
          "id": "t1_formula",
          "slot": "middle",
          "style": "formula",
          "content": "$R_t=r_{t+1}+\\gamma R_{t+1}$",
          "hidden": true
        },
        {
          "id": "t1_note",
          "slot": "bottom",
          "style": "keyword",
          "content": "즉시 보상 + 이후 수익",
          "hidden": true
        }
      ],
      "slides": [],
