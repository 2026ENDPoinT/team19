      "id": "c_compare",
      "slot": "middle",
      "hidden": false,
      "language": "c",
      "lines": [
       "while (n1 <= mid && n2 <= high) {",
       "  if (list[n1] <= list[n2])",
       "    sorted[s++] = list[n1++];",
       "  else sorted[s++] = list[n2++];",
       "}"
      ]
     },
     {
      "id": "c_remaining",
      "slot": "middle",
      "hidden": true,
      "language": "c",
      "lines": [
       "if (n1 > mid)",
       "  while (n2 <= high)",
       "    sorted[s++] = list[n2++];",
       "else while (n1 <= mid)",
       "  sorted[s++] = list[n1++];"
      ]
     },
     {
      "id": "c_copy",
      "slot": "middle",
      "hidden": true,
      "language": "c",
      "lines": [
       "for (i = low; i <= high; i++)",
       "  list[i] = sorted[i];"
      ]
     }
    ],
