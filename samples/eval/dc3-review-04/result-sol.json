      "id": "pseudo_original",
      "slot": "middle",
      "hidden": false,
      "language": "pseudo",
      "lines": [
       "if (p < q) {",
       "  k = ⌊(p+q)/2⌋",
       "  MergeSort(A, p, k)",
       "  MergeSort(A, k+1, q)",
       "  A[p]~A[k] 와 A[k+1]~A[q] 를 합병한다",
       "}"
      ]
     },
     {
      "id": "pseudo_values",
      "slot": "middle",
      "hidden": true,
      "language": "pseudo",
      "lines": [
       "if (0 < 7) {",
       "  k = ⌊(0+7)/2⌋",
       "  MergeSort(A, 0, 3)",
       "  MergeSort(A, 4, 7)",
       "  A[0]~A[3] 와 A[4]~A[7] 를 합병한다",
       "}"
      ]
     }
