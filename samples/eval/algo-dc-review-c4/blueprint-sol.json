          "language": "pseudo",
          "lines": [
            "if (p < q) {",
            "  k = floor((p + q) / 2)",
            "  MergeSort(A, p, k)",
            "  MergeSort(A, k + 1, q)",
            "  merge(A, p, k, q)",
            "}"
          ]
        }
