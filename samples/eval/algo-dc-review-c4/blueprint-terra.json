      "grids": [],
      "codes": [
        {
          "id": "c_sort",
          "slot": "middle",
          "language": "pseudo",
          "hidden": false,
          "lines": [
            "MergeSort(A, p, q):",
            "  if p < q:",
            "    k = floor((p + q) / 2)",
            "    MergeSort(A, p, k)",
            "    MergeSort(A, k+1, q)",
            "    merge(A, p, k, q)"
          ]
        }
      ],
      "actions": [
