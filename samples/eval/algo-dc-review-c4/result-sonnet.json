   "lineIndex": 1,
   "text": "첫 짝 37과 10을 비교해요.",
   "startSec": 53.45,
   "endSec": 57.05
  },
  {
   "sceneId": "s4",
   "lineIndex": 2,
   "text": "10이 더 작으니 10, 37 순서로 합쳐져요.",
   "startSec": 57.35,
   "endSec": 62.5
  },
  {
   "sceneId": "s4",
   "lineIndex": 3,
   "text": "22와 30은 이미 순서대로라 그대로예요.",
   "startSec": 62.8,
   "endSec": 66.9
  },
  {
   "sceneId": "s4",
   "lineIndex": 4,
   "text": "나머지 짝도 합치면 13, 35와 24, 25가 돼요.",
   "startSec": 67.2,
   "endSec": 73.2
  },
  {
   "sceneId": "s5",
   "lineIndex": 0,
   "text": "이어서 10, 37과 22, 30을 합병해요.",
   "startSec": 73.8,
   "endSec": 78.6
  },
  {
   "sceneId": "s5",
   "lineIndex": 1,
   "text": "작은 값부터 꺼내 합치면 10, 22, 30, 37이에요.",
   "startSec": 78.9,
   "endSec": 84.95
  },
  {
   "sceneId": "s5",
   "lineIndex": 2,
   "text": "뒤쪽도 합치면 13, 24, 25, 35가 돼요.",
   "startSec": 85.25,
   "endSec": 90.95
  },
  {
   "sceneId": "s6",
   "lineIndex": 0,
   "text": "마지막은 정렬된 두 묶음을 합치는 일이에요.",
   "startSec": 91.55,
   "endSec": 95.75
  },
  {
   "sceneId": "s6",
   "lineIndex": 1,
   "text": "맨 앞의 10과 13을 비교해요.",
   "startSec": 96.05,
   "endSec": 99.45
  },
  {
   "sceneId": "s6",
   "lineIndex": 2,
   "text": "10이 작아서 결과에 쓰고, 다음은 22 대 13이에요.",
   "startSec": 99.75,
   "endSec": 104.75
  },
  {
   "sceneId": "s6",
   "lineIndex": 3,
   "text": "13을 쓰고, 다음은 22 대 24예요.",
   "startSec": 105.05,
   "endSec": 109.1
  },
  {
   "sceneId": "s7",
   "lineIndex": 0,
   "text": "같은 방식으로 22와 24까지 쓰면 앞 네 칸이 차요.",
   "startSec": 109.7,
   "endSec": 114.85
  },
  {
   "sceneId": "s7",
   "lineIndex": 1,
   "text": "남은 25, 30, 35, 37도 차례로 채워요.",
   "startSec": 115.15,
   "endSec": 120.25
  },
  {
   "sceneId": "s7",
   "lineIndex": 2,
   "text": "10, 13, 22, 24, 25, 30, 35, 37로 정렬이 끝나요.",
   "startSec": 120.55,
   "endSec": 128.55
  }
 ]
}
