      "language": "pseudo",
      "hidden": false,
      "lines": [
       "MergeSort(A, p, q):",
       "  if (p < q):",
       "    k = ⌊(p+q)/2⌋",
       "    MergeSort(A, p, k)",
       "    MergeSort(A, k+1, q)",
       "    A[p..k]와 A[k+1..q] 합병"
      ]
     }
    ],
