      "codes": [
        {
          "id": "c_sort",
          "slot": "middle",
          "language": "pseudo",
          "hidden": false,
          "lines": [
            "1 if p < q:",
            "2   k = floor((p + q) / 2)",
            "3   MergeSort(A, p, k)",
            "4   MergeSort(A, k + 1, q)",
            "5   A[p..k]와 A[k+1..q] 합병"
          ]
        }
      ],
