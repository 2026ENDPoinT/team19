      "codes": [
        {
          "id": "c_ms",
          "slot": "middle",
          "language": "pseudo",
          "hidden": true,
          "lines": [
            "if (p < q) {  // 원소가 2개 이상이면",
            "  k = ⌊(p+q)/2⌋",
            "  MergeSort(A, p, k)  // 앞부분",
            "  MergeSort(A, k+1, q)  // 뒷부분",
            "  A[p~k]와 A[k+1~q]를 합병한다",
            "}"
          ]
        }
      ],
