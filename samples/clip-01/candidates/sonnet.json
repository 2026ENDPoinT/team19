      "codes": [
        {
          "id": "c_ms",
          "slot": "middle",
          "language": "pseudo",
          "hidden": false,
          "lines": [
            "if (p < q) {",
            "  k = ⌊(p+q)/2⌋",
            "  MergeSort(A, p, k)",
            "  MergeSort(A, k+1, q)",
            "  A[p..k]와 A[k+1..q] 합병",
            "}"
          ]
        }
